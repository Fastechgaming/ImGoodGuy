<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= item ? "Edit" : "Add" %> Item · Admin</title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
  <header class="admin-header">
    <h1><%= item ? "Edit item" : "Add item" %></h1>
    <a class="btn-ghost" href="/admin">Back to list</a>
  </header>

  <main class="admin-main">
    <form class="admin-form" method="POST" action="<%= item ? '/admin/items/' + item.id : '/admin/items' %>" enctype="multipart/form-data">
      <label>Category
        <select name="category" required>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= (item ? item.category : defaultCategory) === cat ? "selected" : "" %>><%= cat %></option>
          <% }) %>
        </select>
      </label>

      <label>Name
        <input type="text" name="name" value="<%= item ? item.name : '' %>" required />
      </label>

      <label>Price (USD)
        <input type="number" step="0.01" min="0" name="price" value="<%= item ? item.price : '' %>" required />
      </label>

      <label>Short description (shown on the store card)
        <input type="text" name="shortDesc" value="<%= item ? item.shortDesc : '' %>" />
      </label>

      <label>Full info text (shown in the "!" popup)
        <textarea name="infoText" rows="5"><%= item ? item.infoText : '' %></textarea>
      </label>

      <label>Kit video URL (YouTube embed link, optional)
        <input type="text" name="videoUrl" value="<%= item ? item.videoUrl : '' %>" placeholder="https://www.youtube.com/embed/xxxxx" />
      </label>

      <label>Delivery command (run when you Accept an order in Telegram)
        <input type="text" name="deliveryCommand" value="<%= item ? (item.deliveryCommand || '') : '' %>" placeholder="lp user {player} parent add apsara" />
        <small style="font-weight:400; color:#7a7060;">Use <code>{player}</code> for the in-server name. Leave blank to deliver this item by hand.</small>
      </label>

      <label>Upload image
        <input type="file" name="imageFile" accept="image/*" />
      </label>
      <label>...or image URL / path
        <input type="text" name="imageUrl" value="<%= item ? item.image : '' %>" placeholder="/images/items/example.png" />
      </label>
      <% if (item && item.image) { %>
        <img class="preview" src="<%= item.image %>" alt="current image" />
      <% } %>

      <button class="btn" type="submit"><%= item ? "Save changes" : "Add item" %></button>
    </form>
  </main>
</body>
</html>
