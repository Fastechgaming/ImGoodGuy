# ==============================
# AngkorSMP Website - Environment
# Copy this file to ".env" and fill in the real values.
# NEVER commit your real ".env" file.
# ==============================

# Port the website runs on
PORT=3000

# Which address to bind. Leave unset (0.0.0.0) for local development. Behind a
# Cloudflare Tunnel or nginx, set HOST=127.0.0.1 so the site is reachable only
# through the proxy and never on the machine's public IP.
# HOST=127.0.0.1

# Public base URL of this website. Used for absolute links (e.g. in Telegram
# messages) AND to decide whether to trust proxy headers and mark the session
# cookies Secure - so in production this MUST be your real https:// address.
SITE_URL=http://localhost:3000

# --- Admin Panel (built-in web admin at /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Random long string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# --- Telegram Bot (order notifications + optional admin item management) ---
# Create a bot with @BotFather on Telegram to get a token
TELEGRAM_BOT_TOKEN=
# Your personal Telegram numeric user ID (message @userinfobot to get it).
# Purchase notifications AND /additem etc. admin commands are restricted to this ID.
TELEGRAM_ADMIN_CHAT_ID=
# Public @username shown to customers for support (without the @)
TELEGRAM_SUPPORT_USERNAME=AngkorSMPSupport

# --- Minecraft RCON (used to deliver items when you press "Accept" in Telegram) ---
# Enable these in your server.properties first:
#   enable-rcon=true
#   rcon.port=25575
#   rcon.password=<a long random password>
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=

# --- AngkorStore plugin bridge (optional, see ../AngkorStore/README.md) ---
# When these are set, the website verifies names against the Minecraft server,
# shows live coins and rank(s), and pays mini-game coins straight into the game.
# Leave them empty and the site runs on its own local ledger instead.
# ANGKORSTORE_SECRET must match api.secret in the plugin's config.yml exactly -
# no separate key, no request-signing, just this one shared secret.
ANGKORSTORE_URL=
ANGKORSTORE_SECRET=
