# ==============================
# AngkorSMP Website - Environment
# Copy this file to ".env" and fill in the real values.
# NEVER commit your real ".env" file.
# ==============================

# Port the website runs on
PORT=3000

# Public base URL of this website (used to build absolute links, e.g. for Telegram messages)
SITE_URL=http://localhost:3000

# --- Admin Panel (built-in web admin at /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Random long string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# --- Telegram Bot (order notifications + optional admin item management) ---
# Create a bot with @BotFather on Telegram to get a token
TELEGRAM_BOT_TOKEN=
# Your personal Telegram numeric user ID (message @userinfobot to get it).
# Purchase notifications AND /additem etc. admin commands are restricted to this ID.
TELEGRAM_ADMIN_CHAT_ID=
# Public @username shown to customers for support (without the @)
TELEGRAM_SUPPORT_USERNAME=AngkorSMPSupport

# --- Bakong KHQR (Cambodia NBC payment QR) ---
# The Bakong account/merchant identifier that receives the money (your bank/wallet's Bakong account ID, e.g. someone@bank)
BAKONG_ACCOUNT_ID=
# Name shown on the KHQR / customer's banking app
BAKONG_MERCHANT_NAME=AngkorSMP
# City shown on the KHQR
BAKONG_MERCHANT_CITY=Phnom Penh
# Optional: merchant ID assigned by Bakong for merchant-type QR (leave blank for individual/personal KHQR)
BAKONG_MERCHANT_ID=
# Bakong Open API bearer token, used to verify whether a KHQR has actually been paid.
# Request access at https://api-bakong.nbc.gov.kh (Bakong Open API Developer Portal)
BAKONG_OPENAPI_TOKEN=
