# systemd unit for the AngkorSMP website.
#
#   sudo cp deploy/angkorsmp-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now angkorsmp-web
#
# Logs:    journalctl -u angkorsmp-web -f
# Restart: sudo systemctl restart angkorsmp-web

[Unit]
Description=AngkorSMP website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change these two if you cloned somewhere else or run as another user.
User=minecraft
WorkingDirectory=/opt/angkorsmp/ImGoodGuy/website

ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# .env in WorkingDirectory is loaded by the app itself (dotenv).
Environment=NODE_ENV=production

# Keep the process from wandering outside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/angkorsmp/ImGoodGuy/website/data /opt/angkorsmp/ImGoodGuy/website/config /opt/angkorsmp/ImGoodGuy/website/public/images/items

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
